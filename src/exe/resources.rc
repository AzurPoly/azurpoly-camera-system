/*
 * AZP-Camera.exe resources. build.ps1 writes the icon, the interface and the version header into
 * build/native/generated: the icon from assets/branding/azp-camera-icon.png, the interface from ui/.
 */

#include "resources.hpp"
#include "azp-camera-version.hpp"

AZP_CAMERA_ICON ICON "azp-camera.ico"
AZP_CAMERA_INTERFACE RCDATA "azp-camera-ui.html"

1 VERSIONINFO
FILEVERSION AZP_CAMERA_VERSION_MAJOR, AZP_CAMERA_VERSION_MINOR, AZP_CAMERA_VERSION_PATCH, AZP_CAMERA_BUILD_NUMBER
PRODUCTVERSION AZP_CAMERA_VERSION_MAJOR, AZP_CAMERA_VERSION_MINOR, AZP_CAMERA_VERSION_PATCH, AZP_CAMERA_BUILD_NUMBER
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AzurPoly"
      VALUE "FileDescription", AZP_CAMERA_PRODUCT_NAME
      VALUE "FileVersion", AZP_CAMERA_VERSION
      VALUE "OriginalFilename", "AZP-Camera.exe"
      VALUE "ProductName", AZP_CAMERA_PRODUCT_NAME
      VALUE "ProductVersion", AZP_CAMERA_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
